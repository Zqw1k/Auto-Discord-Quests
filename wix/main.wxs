<?xml version="1.0" encoding="utf-8"?>
<!-- Built by cargo-wix in CI: candle is invoked with -dVersion=<cargo version>
     and -dCargoTargetBinDir=<target\release>. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="QuestPilot"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="Zqw1k"
      UpgradeCode="8D3F0C2A-5B47-4E62-9C1E-2F6A7B4D9E31">
    <Package
        Id="*"
        Keywords="Installer"
        Description="QuestPilot installer"
        Comments="Automate Discord Quests"
        Manufacturer="Zqw1k"
        InstallerVersion="500"
        Languages="1033"
        Compressed="yes"
        SummaryCodepage="1252" />
    <Media Id="1" Cabinet="questpilot.cab" EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of QuestPilot is already installed." />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="QuestPilot">
          <Component Id="QuestPilotBinary" Guid="*">
            <File Id="QuestPilotExe" Name="questpilot.exe"
                  Source="$(var.CargoTargetBinDir)\questpilot.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="QuestPilot">
          <Component Id="QuestPilotShortcut" Guid="*">
            <Shortcut Id="AppShortcut" Name="QuestPilot"
                      Description="Automate Discord Quests"
                      Target="[INSTALLFOLDER]questpilot.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Zqw1k\QuestPilot"
                           Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="QuestPilot" Level="1">
      <ComponentRef Id="QuestPilotBinary" />
      <ComponentRef Id="QuestPilotShortcut" />
    </Feature>
  </Product>
</Wix>
